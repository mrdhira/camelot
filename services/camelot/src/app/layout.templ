package app

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/sheet"
	switchcomp "github.com/axadrn/shadcn-templ/v2/components/switch"

	"github.com/mrdhira/camelot/services/camelot/src/assets"
)

// The navigation's sections.
const (
	NavCockpit  = "cockpit"
	NavBoard    = "board"
	NavInsights = "insights"
	NavDocs     = "docs"
)

// navItem is one link of the header.
type navItem struct {
	Key   string
	Label string
	Short string
	Href  string
}

var navItems = []navItem{
	{Key: NavCockpit, Label: "Cockpit", Href: "/"},
	{Key: NavBoard, Label: "Board", Href: "/board"},
	{Key: NavInsights, Label: "Insights", Href: "/insights"},
	{Key: NavDocs, Label: "Documents", Short: "Docs", Href: "/docs"},
}

// PaletteID is the ⌘K palette dialog.
const PaletteID = "palette"

// layoutComponents are the components of every page: the dialog (palette, panel) and the theme switch.
var layoutComponents = []Component{ComponentDialog, ComponentSwitch}

// Layout is every page's document: the header (navigation with the feed's
// unread count, the live indicator, ⌘K, "New card"), then children in
// <main id="main">; the page's scripts load after the layout's.
templ Layout(title, active string, scripts ...string) {
	{{ shell := shellOf(ctx) }}
	<!DOCTYPE html>
	<html lang="en" class="style-nova">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Camelot</title>
			<link rel="stylesheet" href={ assets.Path("css/app.css") }/>
			<link rel="icon" href="data:,"/>
			<script src={ assets.Path("js/theme.js") }></script>
		</head>
		<body class="min-h-dvh" data-stamp={ shell.Stamp }>
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
			<header class="sticky top-0 z-20 border-b bg-background/95 backdrop-blur">
				<div class="mx-auto flex h-14 max-w-[1600px] items-center gap-2 px-3 sm:gap-3 sm:px-6">
					<a href="/" class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
						<span aria-hidden="true" class="grid size-7 place-items-center rounded-md bg-primary text-xs font-bold text-primary-foreground">C</span>
						<span class="sr-only sm:not-sr-only">Camelot</span>
					</a>
					<nav aria-label="Main" class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto" data-nav>
						for _, item := range navItems {
							@navLink(item, item.Key == active, shell.Unread)
						}
					</nav>
					<p id="live" class="hidden items-center gap-1.5 text-xs text-muted-foreground lg:flex" data-as-of={ ISO(shell.AsOf) }>
						<span aria-hidden="true" class="size-1.5 rounded-full bg-tone-done text-tone-done" data-light></span>
						<span data-live-text>live</span>
					</p>
					<button type="button" class="hidden h-8 items-center gap-2 rounded-md border px-2.5 text-xs text-muted-foreground hover:bg-muted sm:flex" { dialog.TriggerFor(PaletteID)... } aria-keyshortcuts="Meta+K Control+K">
						Search
						<kbd aria-hidden="true" class="rounded border bg-background px-1 font-mono text-[10px] text-foreground">⌘K</kbd>
					</button>
					<label for="theme-switch" class="flex cursor-pointer items-center gap-1.5 text-muted-foreground max-sm:hidden" data-theme-switch hidden title="Light or dark; until switched, the system setting applies">
						@icon.Sun(icon.Props{Size: 16, Attributes: templ.Attributes{"aria-hidden": "true"}})
						@switchcomp.Switch(switchcomp.Props{ID: "theme-switch", Size: switchcomp.SizeSm, Attributes: templ.Attributes{"aria-label": "Dark theme"}})
						@icon.Moon(icon.Props{Size: 16, Attributes: templ.Attributes{"aria-hidden": "true"}})
					</label>
					@button.Button(button.Props{Href: "/tasks/new", Size: button.SizeSm}) {
						<span aria-hidden="true" class="sm:hidden">+</span>
						<span class="sr-only sm:not-sr-only">New card</span>
					}
				</div>
			</header>
			<main id="main" class="mx-auto flex max-w-[1600px] flex-col gap-6 px-3 py-6 sm:px-6">
				{ children... }
			</main>
			<footer class="mx-auto max-w-[1600px] px-3 pb-6 text-xs text-muted-foreground sm:px-6">
				<a href="/design" class="underline underline-offset-4 hover:text-foreground">Design book</a>
				<span aria-hidden="true">·</span>
				<a href="/check" class="underline underline-offset-4 hover:text-foreground">Data quality</a>
			</footer>
			@palette()
			@panelSheet()
			for _, s := range Scripts(layoutComponents, "js/live.js", "js/palette.js", "js/panel.js") {
				<script src={ assets.Path(s) } defer></script>
			}
			for _, s := range scripts {
				if !isLayoutScript(s) {
					<script src={ assets.Path(s) } defer></script>
				}
			}
		</body>
	</html>
}

// navLink is one navigation link; the cockpit's carries the feed's unread count.
templ navLink(item navItem, current bool, unread int) {
	if current {
		@button.Button(button.Props{Href: item.Href, Variant: button.VariantSecondary, Size: button.SizeSm, Attributes: templ.Attributes{"aria-current": "page"}}) {
			@navLabel(item, unread)
		}
	} else {
		@button.Button(button.Props{Href: item.Href, Variant: button.VariantGhost, Size: button.SizeSm}) {
			@navLabel(item, unread)
		}
	}
}

templ navLabel(item navItem, unread int) {
	if item.Short != "" {
		<span class="sm:hidden">{ item.Short }</span>
		<span class="hidden sm:inline">{ item.Label }</span>
	} else {
		{ item.Label }
	}
	if item.Key == NavCockpit && unread > 0 {
		<span data-unread class="ml-1 rounded-full bg-tone-new px-1.5 text-[11px] font-semibold tabular-nums text-tone-new-on">{ itoa(unread) }<span class="sr-only"> updates</span></span>
	}
}

// palette is the ⌘K dialog: a search box over cards, documents and pages;
// js/palette.js fills the list from /search. Submitting without script
// searches the board.
templ palette() {
	@dialog.Dialog(dialog.Props{ID: PaletteID}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl", HideCloseButton: true}) {
			@dialog.Header(dialog.HeaderProps{Class: "sr-only"}) {
				@dialog.Title() {
					Search Camelot
				}
				@dialog.Description() {
					Cards, documents and pages. Arrow keys to choose, Enter to open.
				}
			}
			<form role="search" data-palette-form action="/board" method="get" class="grid gap-2">
				<label for="palette-q" class="sr-only">Search cards, documents and pages</label>
				@input.Input(input.Props{ID: "palette-q", Name: "q", Type: "search", Placeholder: "Search cards, documents, pages…", Attributes: templ.Attributes{"autocomplete": "off", "role": "combobox", "aria-expanded": "true", "aria-controls": "palette-results", "aria-autocomplete": "list"}})
				<ul id="palette-results" role="listbox" aria-label="Results" class="grid max-h-[60vh] gap-0.5 overflow-y-auto" data-palette-results></ul>
				<p class="text-xs text-muted-foreground" data-palette-status role="status"></p>
			</form>
		}
	}
}

// PanelID is the side panel cards open in.
const PanelID = "panel"

// panelSheet is the side panel: js/panel.js loads a card's /tasks/{id}/panel into it.
templ panelSheet() {
	@sheet.Sheet(sheet.Props{ID: PanelID}) {
		@sheet.Content(sheet.ContentProps{Class: "w-full overflow-y-auto sm:max-w-lg"}) {
			@sheet.Header(sheet.HeaderProps{Class: "sr-only"}) {
				@sheet.Title() {
					Card
				}
				@sheet.Description() {
					The card's question, next step, description and latest changes.
				}
			}
			<div class="p-4 pt-10" data-panel-body aria-live="polite"></div>
		}
	}
}

// PageHeader is a page's title, its description and optional actions on the right.
templ PageHeader(title, description string) {
	<div class="flex flex-wrap items-end justify-between gap-3">
		<div class="grid gap-1">
			<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
			if description != "" {
				<p class="text-sm text-muted-foreground">{ description }</p>
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			{ children... }
		</div>
	</div>
}

// Section is a titled block with a note under the title (a formula or a source).
templ Section(title, note string) {
	<section class="grid min-w-0 grid-cols-1 content-start gap-3" aria-label={ title }>
		<div class="grid gap-0.5">
			<h2 class="section-title text-base font-semibold">{ title }</h2>
			if note != "" {
				<p class="text-xs text-muted-foreground">{ note }</p>
			}
		</div>
		{ children... }
	</section>
}

// ErrorPage is a full page for an error: the status and what to do.
templ ErrorPage(status int, message string) {
	@Layout(statusTitle(status), "") {
		@PageHeader(statusTitle(status), message)
		<p>
			@button.Button(button.Props{Href: "/", Variant: button.VariantOutline}) {
				Back to the cockpit
			}
		</p>
	}
}
